        "url": "https://prometheus-prod-56-prod-us-east-2.grafana.net/api/v1/push/influx/write",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=temperatura_celsius,sensor={{ $json.sensor_num }},ubicacion={{ $json.ubicacion }} value={{ $json.temperatura_celsius }}\nhumedad_relativa,sensor={{ $json.sensor_num }},ubicacion={{ $json.ubicacion }} value={{ $json.humedad_relativa }}\nnivel_bateria,sensor={{ $json.sensor_num }},ubicacion={{ $json.ubicacion }} value={{ $json.nivel_bateria }}",
        "options": {}
