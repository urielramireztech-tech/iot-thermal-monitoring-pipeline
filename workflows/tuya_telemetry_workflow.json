      ],
      "id": "0eb32631-7779-44d0-aea1-96fdda0b7ab5",
      "name": "Leer los datos del sensor"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Obtenemos el arreglo de resultados crudos del paquete actual\nconst datos_crudos = $json.result;\n\n// 2. Buscamos los valores específicos en el arreglo por su código de variable\nconst temp_cruda = datos_crudos.find(item => item.code === \"va_temperature\").value;\nconst hum_cruda = datos_crudos.find(item => item.code === \"va_humidity\").value;\nconst bat_cruda = datos_crudos.find(item => item.code === \"battery_percentage\").value;\n\n// 3. Escalamos la temperatura (Tuya entrega 240 para 24.0°C)\nconst temperatura_celsius = temp_cruda / 10;\n\n// 4. Rescatamos las variables de contexto del sensor EN TURNO usando la memoria del nodo anterior\nconst sensor_num = $('Preparar la lectura del sensor').item.json.sensor_num;\nconst ubicacion = $('Preparar la lectura del sensor').item.json.ubicacion;\n\n// 5. Retornamos el paquete limpio y ordenado para inyectarlo a Grafana\nreturn {\n  temperatura_celsius: temperatura_celsius,\n  humedad_relativa: hum_cruda,\n  nivel_bateria: bat_cruda,\n  sensor_num: sensor_num,\n  ubicacion: ubicacion\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        0
      ],
      "id": "000fec13-f80c-477d-bf51-ca12e3c231e6",
      "name": "Filtrado y escalado de variables"
    },
