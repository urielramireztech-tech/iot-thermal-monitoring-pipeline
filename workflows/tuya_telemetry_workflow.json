      "name": "Declaración de variables de tuya y grafana"
    },
    {
      "parameters": {
        "jsCode": "// Extraemos tu ID del nodo anterior\nconst clientId = $input.item.json.tuya_client_id;\n\n// Obtenemos la hora actual en milisegundos (Tuya lo exige)\nconst t = Date.now().toString();\n\n// Preparamos los textos exactos para la firma\nconst contentHash = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\";\nconst stringToSign = \"GET\\n\" + contentHash + \"\\n\\n/v1.0/token?grant_type=1\";\n\n// Guardamos los resultados para el siguiente paso\n$input.item.json.tuya_t = t;\n$input.item.json.texto_para_firmar = clientId + t + stringToSign;\n\nreturn $input.item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "a02163fd-d4ce-40c2-af41-cc2f09044c08",
      "name": "Preparación de textos y llave que tuya requiere"
    },
    {
      "parameters": {
        "action": "hmac",
        "value": "={{ $json.texto_para_firmar }}",
        "dataPropertyName": "tuya_sign"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        608,
        0
      ],
      "id": "492491e0-99ec-45fc-8597-abcf46d416d1",
      "name": "Generación De Firma Criptográfica",
      "credentials": {
        "crypto": {
          "id": "Your ID",
          "name": "Tuya - account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://openapi.tuyaus.com/v1.0/token?grant_type=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $json.tuya_client_id }}"
            },
            {
              "name": "sign",
              "value": "={{ $json.tuya_sign.toUpperCase() }}"
            },
            {
              "name": "t",
              "value": "={{ $json.tuya_t }}"
            },
            {
              "name": "sign_method",
              "value": "HMAC-SHA256"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        816,
        0
      ],
      "id": "f169a128-156d-4971-a1f2-6cb00c1f1d1d",
      "name": "Tocar la puerta de Tuya"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Extraemos las variables fijas del primer nodo (estas no cambian por sensor)\nconst tuya_client_id = $('Declaración de variables de tuya y grafana').first().json.tuya_client_id;\nconst tuya_secret = $('Declaración de variables de tuya y grafana').first().json.tuya_secret;\n\n// 2. Extraemos los datos dinámicos del sensor EN TURNO (que nos entrega el Loop)\n// Como estamos dentro del ciclo, usamos $json para leer el paquete actual\nconst tuya_device_id = $json.device_id;\nconst token_tuya = $json.token_tuya;\n\n// 3. Obtenemos el timestamp actual en milisegundos (Tuya lo requiere para cada firma)\nconst timestamp = new Date().getTime().toString();\n\n// 4. Construimos la ruta de la API específica para ESTE sensor\nconst endpoint = `/v1.0/iot-03/devices/${tuya_device_id}/status`;\n\n// 5. Preparamos la cadena a firmar (String to Sign)\nconst method = \"GET\";\nconst content_sha256 = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"; // Hash SHA256 de un cuerpo vacío\nconst headers = \"\";\nconst stringToSign = [method, content_sha256, headers, endpoint].join(\"\\n\");\n\n// 6. Construimos el mensaje completo para HMAC\nconst message = tuya_client_id + token_tuya + timestamp + stringToSign;\n\n// Retornamos las variables listas para el nodo Crypto\nreturn {\n  tuya_client_id: tuya_client_id,\n  tuya_secret: tuya_secret,\n  token_tuya: token_tuya,\n  timestamp: timestamp,\n  message_to_sign: message,\n  endpoint: endpoint,\n  sensor_num: $json.sensor_num,\n  ubicacion: $json.ubicacion\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "id": "29abb2fe-9261-460a-9727-a35ce6deb9c4",
      "name": "Preparar la lectura del sensor"
    },
