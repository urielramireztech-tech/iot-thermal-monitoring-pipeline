      "id": "0c6aaa38-7a5c-4021-bea4-b7915392aefb",
      "name": "Leer un sensor a la vez"
    },
    {
      "parameters": {
        "jsCode": "// 1. Extraemos el token fresco que acaba de generar Tuya\nconst token = $input.first().json.result.access_token;\n\n// 2. Extraemos la matriz de sensores que declaramos en el primer nodo\nconst sensores = $('Declaración de variables de tuya y grafana').first().json.sensores;\n\n// 3. Generamos un \"paquete\" (item) por cada sensor para que el ciclo los procese uno por uno\nreturn sensores.map(sensor => {\n  return {\n    json: {\n      device_id: sensor.device_id,\n      sensor_num: sensor.sensor_num,\n      ubicacion: sensor.ubicacion,\n      token_tuya: token\n    }\n  };\n});"
      },
